NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

DB_HOST=localhost
DB_PORT=3306
DB_NAME=iot
DB_USER=root
DB_PASSWORD=change-me
DB_SYNC=safe

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

MQTT_ENABLED=true
# Backend process -> Mosquitto on the same development machine
MQTT_URL=mqtt://localhost:1883
# Broker URL returned to ESP32 in claim/credential responses (must be reachable from the device, e.g. mqtts://broker.example.com:8883).
# Empty = reuse MQTT_URL.
MQTT_DEVICE_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=iot
# MQTT prefix for Firmware v1.2 topics sf/<nodeCode>/...
MQTT_FIRMWARE_TOPIC_PREFIX=sf
# Dynamic Security provisions one independent MQTT username/password + ACL role for every Node.
# Set true only after the Mosquitto dynamic-security plugin is installed and initialized.
MQTT_DYNSEC_ENABLED=false
MQTT_DYNSEC_ADMIN_USERNAME=iot_dynsec_admin
MQTT_DYNSEC_ADMIN_PASSWORD=replace-with-dynamic-security-admin-password
MQTT_DYNSEC_REQUEST_TIMEOUT_MS=8000

# Claim endpoint accepts HTTPS at the Node process or HTTPS forwarded from these
# exact reverse-proxy IPs (not arbitrary X-Forwarded-Proto). Keep the Node port private.
CLAIM_TRUSTED_PROXY_IPS=
# Require HTTPS for claim/token issuing and mqtts:// for devices. Default: true when NODE_ENV=production, false otherwise.
# Set false only on an isolated dev LAN (ESP32 claims over http:// and connects to MQTT 1883).
CLAIM_REQUIRE_TLS=

HEARTBEAT_SWEEP_SEC=10
COMMAND_ACK_TIMEOUT_SEC=15
# Legacy firmware only: timeout chờ Node phản hồi device/probe (giây). Firmware v1.2 dùng inventory, không dùng probe.
DEVICE_PROBE_TIMEOUT_SEC=8

# Quy tắc cảnh báo ngưỡng. Có thể giữ mặc định hoặc ghi đè bằng JSON hợp lệ.
# Đơn vị: soil moisture/air humidity = %, air temperature = °C.
# Hysteresis: lowRecovery phải >= low; highRecovery phải <= high để tránh cảnh báo nhấp nháy.
# SENSOR_THRESHOLD_RULES_JSON={"SOIL_MOISTURE":{"low":20,"lowRecovery":28,"high":88,"highRecovery":82}}

# ---- Camera phone upload ----
# Kích thước media tối đa nhận từ điện thoại (10 MiB mặc định). Hỗ trợ JPEG, PNG, WebP, MP4.
CAMERA_IMAGE_MAX_BYTES=10485760
# Thư mục local lưu ảnh/video camera; dùng ổ đĩa có backup và đủ dung lượng.
CAMERA_IMAGE_STORAGE_DIR=storage/camera-media

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_FULL_NAME=System Administrator
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisPassword123!

# External AI API used by Backend after image upload. Set private values in Backend/.env.
# Để trống AI_* hoặc CLOUDINARY_* → ảnh camera được lưu trên đĩa (CAMERA_IMAGE_STORAGE_DIR), không gọi AI.
AI_API_URL=
AI_API_KEY=
AI_REQUEST_TIMEOUT_MS=60000

# Cloudinary: ảnh Camera được lưu trên Cloudinary, DB lưu secure_url/public_id/hash
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=smart-agri/camera-media
