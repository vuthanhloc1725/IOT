# ============================================================================
# IoT Smart Agriculture - local/LAN Docker deployment
# Copy to deployment/.env and replace every CHANGE_ME value before starting.
# Never commit deployment/.env or share its secrets.
# ============================================================================

# MySQL 8
MYSQL_USER=iot_app
MYSQL_PASSWORD=CHANGE_ME_APP_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_HOST_PORT=3307

# Backend authentication. Generate a long random secret, e.g. openssl rand -hex 48
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
JWT_EXPIRES_IN=8h

# Browser/API access. The UI uses same-origin /api and /socket.io through Nginx.
CORS_ORIGIN=*
HTTP_PORT=8080

# MQTT broker. Backend uses the Docker hostname internally; ESP32/Camera Agent
# must use the host machine's LAN IP, not the Docker service name.
MQTT_HOST_BIND=0.0.0.0
MQTT_HOST_PORT=1883
MQTT_DEVICE_URL=mqtt://192.168.1.100:1883
MQTT_BACKEND_USERNAME=agri_backend
MQTT_BACKEND_PASSWORD=CHANGE_ME_BACKEND_MQTT_PASSWORD

# Mosquitto Dynamic Security administrator (not a per-Node credential).
MQTT_DYNSEC_ADMIN_USERNAME=iot_dynsec_admin
MQTT_DYNSEC_ADMIN_PASSWORD=CHANGE_ME_DYNSEC_ADMIN_PASSWORD
MQTT_DYNSEC_REQUEST_TIMEOUT_MS=8000

# Set false only for an isolated trusted LAN using HTTP + MQTT 1883.
# Public deployment must use HTTPS + MQTTS and a separately configured TLS broker.
CLAIM_REQUIRE_TLS=false
CLAIM_TRUSTED_PROXY_IPS=

# Runtime timeouts
HEARTBEAT_SWEEP_SEC=10
COMMAND_ACK_TIMEOUT_SEC=15
DEVICE_PROBE_TIMEOUT_SEC=8

# Sensor thresholds (optional JSON override; omit/leave empty for Backend defaults)
SENSOR_THRESHOLD_RULES_JSON=

# Camera / AI upload limits and persistence paths (paths are inside Backend container)
CAMERA_IMAGE_MAX_BYTES=10485760
AI_IMAGE_MAX_BYTES=5242880
AI_REQUEST_TIMEOUT_MS=60000

# Optional external AI service. Leave blank to keep external AI disabled.
AI_API_URL=
AI_API_KEY=

# Optional Cloudinary storage. Leave blank to use persistent local backend-storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=smart-agri/camera-media
