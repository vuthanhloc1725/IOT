# Proposed replacement for the current system broker configuration.
# REVIEW/STAGE ONLY: provision Dynamic Security state (including agri_backend)
# and set mosquitto ownership/write permissions before deploying this file.
# Existing TLS files and listener addresses are preserved.
per_listener_settings false
allow_anonymous false
plugin /usr/lib/mosquitto_dynamic_security.so
plugin_opt_config_file /var/lib/mosquitto/dynamic-security.json

listener 1883 0.0.0.0

listener 8883 0.0.0.0
cafile /etc/mosquitto/certs/ca.crt
certfile /etc/mosquitto/certs/server.crt
keyfile /etc/mosquitto/certs/server.key
tls_version tlsv1.2
